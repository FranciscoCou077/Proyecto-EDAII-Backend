from sqlalchemy import Column, Integer, String, Text, DateTime
from datetime import datetime
from .database import Base

class ChatHistorial(Base):
    __tablename__ = "historial_chatbot"
    id = Column(Integer, primary_key=True, index=True)
    session_id = Column(String(100), nullable=False)
    rol = Column(String(20)) # 'user' o 'assistant'
    contenido = Column(Text, nullable=False)
    timestamp = Column(DateTime, default=datetime.utcnow)

class EjecucionAlgoritmo(Base):
    __tablename__ = "ejecuciones_algoritmos"
    id = Column(Integer, primary_key=True, index=True)
    nombre_algoritmo = Column(String(100))
    parametros = Column(Text)
    resultado = Column(Text)
    fecha_ejecucion = Column(DateTime, default=datetime.utcnow)

